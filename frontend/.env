# ============================================================================
# File: frontend/.env.example
# Copy to frontend/.env. Vite only exposes vars prefixed VITE_ to the
# browser — never put secrets here, only public client IDs/URLs.
# ============================================================================

VITE_API_BASE_URL=http://localhost:8000/api

# From Google Cloud Console — must match GOOGLE_OAUTH_CLIENT_ID in backend/.env
VITE_GOOGLE_CLIENT_ID=
